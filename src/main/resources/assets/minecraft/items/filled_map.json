{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "isPhotographyEmptyMap",
        "model":{
          "type": "minecraft:model",
          "model": "photography:item/empty_photographic_paper"
        }
      },
      {
        "when": "isPhotographyFilledMap",
        "model":{
          "type": "minecraft:model",
          "model": "photography:item/filled_photographic_paper"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/filled_map"
    }
  },
  "properties": {
    "hand_animation_on_swap": true
  }
}